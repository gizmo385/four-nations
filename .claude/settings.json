{
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)",
      "Bash(gh pr update-branch *)",
      "Bash(gh pr checks *)",
      "Bash(scripts/cleanup-merged.sh)",
      "Bash(scripts/cleanup-merged.sh *)"
    ]
  },
  "attribution": {
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-polling-loops.sh"
          }
        ]
      }
    ]
  }
}
